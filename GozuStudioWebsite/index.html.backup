":59,"content":95},[96],{"type":62,"attrs":97,"content":100},{"textAlign":98,"key":99},null,"p-0",[101],{"text":102,"type":72},"Autonomous, agentic AI-driven workflows from gate to dock",{"_uid":104,"image":105,"label":109,"component":93,"label_rich":110},"98e6d4c0-8194-4634-8f82-e56684338a38",{"id":106,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":107,"copyright":24,"fieldtype":26,"meta_data":108,"is_external_url":28},23045138,"https://a.storyblok.com/f/337048/x/5c039660e1/vid_3-3_prerender_1.mp4",{},"OTIF penalties fade away.",{"type":59,"content":111},[112],{"type":62,"content":113},[114],{"text":115,"type":72},"Single pane of glass visibility of all yard operations",{"_uid":117,"image":118,"label":122,"component":93,"label_rich":123},"710e1e73-b601-4a4d-8c40-75da12b74eee",{"id":119,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":120,"copyright":24,"fieldtype":26,"meta_data":121,"is_external_url":28},23045136,"https://a.storyblok.com/f/337048/x/daeedd63c8/vid_3-5_prerender_1.mp4",{},"Every asset is fully visible and predictable throughout its full journey.",{"type":59,"content":124},[125],{"type":62,"content":126},[127],{"text":128,"type":72},"Managed by a unified platform with AI computer vision",{"_uid":130,"image":131,"label":135,"component":93,"label_rich":136},"c6d260d6-621b-493e-a734-4f243c9d2add",{"id":132,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":133,"copyright":24,"fieldtype":26,"meta_data":134,"is_external_url":28},23045137,"https://a.storyblok.com/f/337048/x/5d1992bef6/vid_3-2_prerender_1.mp4",{},"Information silos across the supply chain vanish.",{"type":59,"content":137},[138],{"type":62,"content":139},[140],{"text":141,"type":72},"Highly configurable to all yards in your network",{"_uid":143,"image":144,"component":93,"label_rich":148},"1c521b42-53d2-4afa-8fbb-3ce59db5d0d5",{"id":145,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":146,"copyright":24,"fieldtype":26,"meta_data":147,"is_external_url":28},23016803,"https://a.storyblok.com/f/337048/x/cbcaf12722/hp-where-4.mp4",{},{"type":59,"content":149},[150],{"type":62,"content":151},[152],{"text":153,"type":72},"Unlocked value of  your existing WMS/TMS",{"_uid":155,"image":156,"component":93,"label_rich":160},"77cdca65-4791-4903-8038-d986797cb042",{"id":157,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":158,"copyright":24,"fieldtype":26,"meta_data":159,"is_external_url":28},23045276,"https://a.storyblok.com/f/337048/x/408e8d26ba/vid_5-4_prerender_1.mp4",{},{"type":59,"content":161},[162],{"type":62,"content":163},[164],{"text":165,"type":72},"Digitally transformed, data rich, and predictive","FeaturesSteps",{"_uid":168,"component":169},"8f8ace68-3b83-4bc1-8ef4-cb8ed0fee1d5","YOSSection",{"_uid":171,"items":172,"layout":268,"component":269},"4ef2ecc6-a082-436a-b86f-8809bfc6d35d",[173,207,235],{"_uid":174,"image":175,"title":179,"layout":24,"content":200,"component":201,"pre_title":202,"image_mobile":203},"c7cbbc3f-8727-4fbd-a614-f54d4543e3dc",{"id":176,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":177,"copyright":24,"fieldtype":26,"meta_data":178,"is_external_url":28},23045352,"https://a.storyblok.com/f/337048/x/85fd9d83d7/vid_4-1_wide_prerender_1.mp4",{},{"type":59,"content":180},[181],{"type":62,"content":182},[183,185,189,191,193,195],{"text":184,"type":72},"A single ",{"text":186,"type":72,"marks":187},"solution",[188],{"type":77},{"text":190,"type":72}," for",{"type":192},"hard_break",{"text":194,"type":72},"maximum, automated ",{"text":196,"type":72,"marks":197},"throughput",[198],{"type":199},"underline","Deep integrations anticipate incoming loads, enabling our AI computer vision technology to automate gate check-ins and all critical yard operations: from assigning locations and maintaining real-time visibility to coordinating spotters for efficient load movement. It then closes the loop by validating assets before exit, providing comprehensive performance supervision across your entire yard network","FullscreenFeaturesItem","Benefit 01",{"id":204,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":205,"copyright":24,"fieldtype":26,"meta_data":206,"is_external_url":28},23045355,"https://a.storyblok.com/f/337048/x/cca5bc6b32/vid_4-1_vert_prerender_1.mp4",{},{"_uid":208,"image":209,"title":213,"content":229,"component":201,"pre_title":230,"image_mobile":231},"8b61931d-319c-4e9f-89aa-fd65fd7b3d79",{"id":210,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":211,"copyright":24,"fieldtype":26,"meta_data":212,"is_external_url":28},23045350,"https://a.storyblok.com/f/337048/x/b29a0119a7/vid_4-2_wide_prerender_1.mp4",{},{"type":59,"content":214},[215],{"type":62,"content":216},[217,222,224,225],{"text":218,"type":72,"marks":219},"Easy",[220,221],{"type":77},{"type":199},{"text":223,"type":72},", scalable",{"type":192},{"text":226,"type":72,"marks":227},"operation",[228],{"type":77},"Terminal was designed from the ground up for disruption-free operations. Easy to deploy and support, the system has a low IT lift with no 3rd party devices to support, and a modern UI/UX that's super-easy for operators to use from day one. Configurable to your yard, Terminal YOS integrates seamlessly with most TMS and WMS systems.","Benefit 02",{"id":232,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":233,"copyright":24,"fieldtype":26,"meta_data":234,"is_external_url":28},23045353,"https://a.storyblok.com/f/337048/x/cd4b14d97d/vid_4-2_vert_prerender_1.mp4",{},{"_uid":236,"image":237,"title":241,"content":262,"component":201,"pre_title":263,"image_mobile":264},"814bee6f-1680-40f5-8464-d06d63c421e4",{"id":238,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":239,"copyright":24,"fieldtype":26,"meta_data":240,"is_external_url":28},23072134,"https://a.storyblok.com/f/337048/x/0f153ebd58/vid_4-3_wide_v02_1.mp4",{},{"type":59,"content":242},[243,255],{"type":62,"content":244},[245,249,251],{"text":246,"type":72,"marks":247},"Rapid",[248],{"type":77},{"text":250,"type":72},", ",{"text":252,"type":72,"marks":253},"repeatable",[254],{"type":77},{"type":62,"content":256},[257],{"text":258,"type":72,"marks":259},"ROI",[260,261],{"type":77},{"type":199},"We know that yard operations run on lean budgets, which is why we price our all-inclusive solution as a service with terms that won’t bust the bank. Ready to deploy right away, and rapid to scale over time. ","Benefit 03",{"id":265,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":266,"copyright":24,"fieldtype":26,"meta_data":267,"is_external_url":28},23072133,"https://a.storyblok.com/f/337048/x/6aa67249be/vid_4-3_vert_v02_1.mp4",{},"layout-1","FullscreenFeatures",{"css":271,"_uid":272,"copy":273,"label":277,"title":278,"buttons":285,"component":81,"isFullscreen":28,"background_type":82,"multipleColumns":28,"buttons_underlined":28,"isFollowingLogosGrid":28},"hp-si2","972fd381-bdf9-4886-8b15-f7174b977988",{"type":59,"content":274},[275,276],{"type":62},{"type":62},"Built by the Industry",{"type":59,"content":279},[280],{"type":66,"attrs":281,"content":282},{"level":68},[283],{"text":284,"type":72},"Built by logistics leaders who want a new industry standard in the yard",[],{"_uid":287,"items":288,"component":309},"0cbcbbfc-a82c-402e-9bf6-10c499bc38fd",[289,293,297,301,305],{"id":290,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":291,"copyright":24,"fieldtype":26,"meta_data":292},22312695,"https://a.storyblok.com/f/337048/147x41/4343e31b5a/ryder.svg",{},{"id":294,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":295,"copyright":24,"fieldtype":26,"meta_data":296},22312693,"https://a.storyblok.com/f/337048/181x34/ff208a2c17/prologis.svg",{},{"id":298,"alt":24,"name":24,"focus":24,"title":24,"source":24,"filename":299,"copyright":24,"fieldtype":26,"meta_data":300},22312696,"https://a.storyblok.com/f/337048/118x46/d178bf93df/nfi.svg",{},{"id":302,"alt":24,"name":24,"focu